#!/bin/bash
# post-commit dispatcher. Advisory: parts run for side effects only. A failing
# part is reported but never aborts the rest or the commit that landed.
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
PARTS=(
)
for part in "${PARTS[@]}"; do
    script="$HOOK_DIR/$part"
    [ -x "$script" ] || continue
    "$script" || echo "post-commit: $part exited non-zero (ignored)"
done
exit 0
