#!/bin/bash
# pre-commit dispatcher. Runs each sub-script in order. Fail closed: a non-zero
# sub-script aborts the commit. Edit PARTS to add/reorder concerns.
set -e
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
PARTS=(
    pre-commit.wiki.sh
    pre-commit.wiki-mesh.sh
    pre-commit.biome.sh
    pre-commit.plugin-version.sh
    pre-commit.version-consistency.sh
)
for part in "${PARTS[@]}"; do
    script="$HOOK_DIR/$part"
    [ -x "$script" ] || continue
    "$script"
done
exit 0
