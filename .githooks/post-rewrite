#!/bin/bash
# Repository post-rewrite hook: git-mesh re-attribution after history rewrite

# git passes old/new SHA pairs on stdin
STDIN_DATA=$(cat)

if command -v git-mesh >/dev/null 2>&1; then
  echo "$STDIN_DATA" | git mesh rewrite
  git mesh stale --compact --auto-follow --no-exit-code
fi

exit 0
