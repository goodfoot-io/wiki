# Enforce LF line endings in the repository on all platforms
* text=auto
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Resolve version conflicts automatically during merges by picking the highest semver
.claude-plugin/marketplace.json merge=json-version
plugins-claude/*/.claude-plugin/plugin.json merge=json-version
plugins-codex/*/.codex-plugin/plugin.json merge=json-version
plugins-opencode/*/package.json merge=json-version

# Resolve .mesh/ merge conflicts structurally via git-mesh merge driver
.mesh/** merge=mesh

# Resolve .span/ merge conflicts structurally via git-span merge driver
.span/** merge=span
