        {
          "platform": "codex",
          "path": "plugins-codex/wiki/skills"
        },
        {
          "platform": "opencode",
          "path": "plugins-opencode/wiki/skills"
        },
        {
          "platform": "antigravity",
          "path": "plugins-antigravity/wiki/skills"
        },
        {
          "platform": "opencode",
          "path": "skills",
          "note": "The shared AGENTS.md-convention root that .agents/skills/wiki symlinks into. Rendered in the OpenCode dialect because that dialect is what AGENTS.md-based hosts read; wiki is the only plugin here, so nothing else can collide on a skill name."
        }
      ],
      "platformDirs": [
        "claude-code:skills=plugins-claude/wiki/skills",
        "claude-code:hooks=plugins-claude/wiki/hooks",
        "claude-code:plugin=plugins-claude/wiki",
        "claude-code:conventions=CLAUDE.md",
        "codex:skills=plugins-codex/wiki/skills",
        "codex:hooks=plugins-codex/wiki/hooks",
        "codex:plugin=plugins-codex/wiki",
        "codex:conventions=AGENTS.md",
        "opencode:skills=plugins-opencode/wiki/skills",
        "opencode:hooks=plugins-opencode/wiki/dist",
        "opencode:plugin=plugins-opencode/wiki",
        "opencode:conventions=AGENTS.md",
        "antigravity:skills=plugins-antigravity/wiki/skills",
        "antigravity:plugin=plugins-antigravity/wiki",
        "antigravity:conventions=AGENTS.md"
      ],
      "lintBaseline": {
