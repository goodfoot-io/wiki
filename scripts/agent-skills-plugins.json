{
  "$comment": "Bundler-managed plugin registry consumed by scripts/agent-skills-registry.mjs. Every path is repo-root-relative.",
  "sharedOpencodeRoot": "skills",
  "plugins": [
    {
      "name": "wiki",
      "skillsSrc": "skills-src/wiki",
      "skills": [
        "wiki"
