{
  "name": "@goodfoot/wiki-monorepo",
  "version": "1.0.0",
  "workspaces": {
    "packages": [
      "packages/*",
      "npm/*"
    ]
  },
  "scripts": {
    "reset": "find . -type d -name node_modules | xargs rm -rf && rm -rf yarn.lock",
    "build:agent-skills": "node scripts/build-agent-skills.mjs",
    "lint:agent-skills": "node scripts/lint-agent-skills.mjs",
    "knip": "knip --config ./knip.config.json",
    "knip:fix": "knip --fix --config ./knip.config.json",
    "lint": "yarn lint:root && yarn workspaces foreach --parallel -A --exclude @goodfoot/wiki-monorepo run lint",
    "lint:root": "biome ci --error-on-warnings scripts .claude plugins-claude plugins-codex plugins-opencode plugins-antigravity packages/cli/scripts",
    "lint:fix": "biome check --write --unsafe .",
    "test": "yarn workspaces foreach -A run test",
    "test:skip-cache": "DISABLE_TEST_CACHE=true yarn workspaces foreach -A run test",
    "typecheck": "bash scripts/typecheck.sh",
    "build": "yarn workspaces foreach -At run build",
    "watch": "yarn workspaces foreach -Api run watch",
    "build:debug": "yarn workspaces foreach -A run build:debug",
    "clean:tsbuildinfo": "find . -name 'tsconfig.tsbuildinfo' -not -path '*/node_modules/*' -not -path '*/.worktrees/*' -delete",
    "validate": "bash scripts/validate.sh",
    "bench": "yarn workspace @goodfoot/wiki bench",
    "bump": "bash scripts/bump.sh && yarn install",
    "release": "bash scripts/release.sh"
  },
  "private": true,
  "packageManager": "yarn@4.16.0",
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@goodfoot/agent-skills": "1.0.25",
    "@types/node": "24.x",
    "knip": "^5.82.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "puppeteer-core": "^24.42.0"
  }
}
