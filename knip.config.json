{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [".claude/skills/**/*.mjs", "scripts/*.mjs"],
      "project": [".claude/skills/**/*.mjs", "scripts/*.mjs"],
      "ignoreDependencies": ["@goodfoot/agent-skills"]
    },
    "packages/agent-hooks": {
      "entry": ["src/**/*.ts", "test/**/*.ts", "scripts/*.{js,mjs}"],
      "project": ["src/**/*.ts", "test/**/*.ts", "scripts/*.{js,mjs}"]
    },
    "packages/cli": {
      "entry": ["scripts/*.{js,mjs}"],
      "project": ["scripts/*.{js,mjs}"]
    },
    "packages/extension": {
      "entry": ["src/**/*.ts", "test/**/*.ts", "scripts/bundle/*.js"],
      "project": ["src/**/*.ts", "test/**/*.ts", "scripts/bundle/*.js"]
    },
    "packages/vscode-logging": {
      "entry": ["src/**/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@types/vscode"]
    }
  }
}
