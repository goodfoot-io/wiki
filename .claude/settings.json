{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "VOICE_SERVER_HTTP_PORT": "5555",
    "VOICE_SERVER_START_BY_DEFAULT": "0",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "250000"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [],
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings"
    ],
    "defaultMode": "bypassPermissions",
    "disableAutoMode": "disable"
  },
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "worktree": {
    "bgIsolation": "none"
  },
  "disableWorkflows": true,
  "disableArtifact": false,
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "typescript-hooks@goodfoot": true,
    "goodfoot@goodfoot": true,
    "jsdoczoom@goodfoot": true,
    "frontend-design@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "agent-hooks@goodfoot": true,
    "agent-skills@goodfoot": true,
    "git-span@git-span": true,
    "wiki@goodfoot-wiki": true,
    "cards-sdk@cards.management": true
  },
  "extraKnownMarketplaces": {
    "git-span": {
      "source": {
        "source": "github",
        "repo": "goodfoot-io/git-span"
      }
    },
    "goodfoot": {
      "source": {
        "source": "github",
        "repo": "goodfoot-io/marketplace"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "goodfoot-wiki": {
      "source": {
        "source": "directory",
        "path": "/home/node/wiki"
      }
    }
  },
  "effortLevel": "medium",
  "askUserQuestionTimeout": "never",
  "autoMemoryEnabled": false
}
