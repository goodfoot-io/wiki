{
  "name": "@goodfoot/wiki-agent-hooks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "yarn build:hooks && yarn build:hooks:codex && yarn build:opencode",
    "build:hooks": "yarn agent-hooks-cli --agent claude-code -i \"src/claude/post-tool-use.ts\" -o \"../../plugins-claude/wiki/hooks/hooks.json\" --no-sourcemap",
    "build:hooks:codex": "yarn agent-hooks-cli --agent codex -i \"src/codex/post-tool-use.ts\" -o \"../../plugins-codex/wiki/hooks/hooks.json\" --plugin-root --no-sourcemap",
    "build:opencode": "yarn agent-hooks-cli --agent opencode -i \"src/opencode/index.ts\" -o \"../../plugins-opencode/wiki/dist\" --no-sourcemap",
    "agent-hooks-cli": "node scripts/hooks-cli-wrapper.js",
    "lint": "npx biome check src test scripts",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@goodfoot/agent-hooks": "1.0.9"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
